---
import styles from './WorkflowStory.module.scss';
import type { Locale } from '../../i18n/locale';
import { homepageStories, homepageMedia } from '../../site/homepage-showcase';
import ThreePillars from './ThreePillars.astro';
import CommunitySupport from './CommunitySupport.astro';
import type { Region } from '../../config/region';
import revealSource from '../../styles/stories-reveal.js?raw';
interface Props { region: Region; locale: Locale }
const { region, locale } = Astro.props;
---
<div data-home-section="workflow" class:list={[styles.inner, styles.section, styles.workflow]}>
  <CommunitySupport region={region} locale={locale} />
  <ThreePillars region={region} locale={locale} />
  <div data-home-stories class={styles.stories}>
    {homepageStories[locale].map((story, index) => {
      const media = homepageMedia[story.id];
      const external = story.link.href.startsWith('https:');
      return <section data-home-story={story.id} aria-labelledby={`story-${story.id}`} class:list={[styles.storyRow, index === 1 && styles.storySecond]}>
        <div class:list={[styles.storyText, index === 0 && styles.storyTextRight]}>
          <h2 id={`story-${story.id}`} data-story-part="title" class:list={[styles.storyHeading, styles.storyMotion, styles.storyTitleReveal]}>{story.title}</h2>
          <p data-story-part="body" class:list={[styles.storyBody, styles.storyMotion, styles.storyBodyReveal]}>{story.body}</p>
          <div data-story-part="link" class:list={[styles.storyLink, styles.storyMotion, styles.storyLinkReveal]}><a href={story.link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class={styles.link}><span class={styles.linkText}>{story.link.label}</span></a></div>
        </div>
        <div data-story-part="image" aria-hidden="true" class:list={[styles.storyArtwork, styles.storyMotion, styles.storyImageReveal, index === 0 && styles.storyArtworkLeft]}>
          <img src={media.src} width={media.width} height={media.height} alt="" draggable="false" loading="lazy" decoding="async" class={styles.storyImage} />
        </div>
      </section>;
    })}
  </div>
  <script is:inline id="t4f-home-stories" set:html={revealSource} />
</div>
