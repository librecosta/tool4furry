---
import * as stylex from '@stylexjs/stylex';
import type { Locale } from '../../i18n/locale';
import { localizedPath } from '../../i18n/locale';
import type { Region } from '../../config/region';
import type { CatalogEntry } from '../../site/catalog';
import { messages } from '../../i18n/messages';
import { tools as registry } from '../../tools/registry';
import { homepageCopy, homepageMedia } from '../../site/homepage-showcase';
import { homeStyles as h } from '../../styles/homepage';
import HomeMedia from './HomeMedia.astro';
interface Props { region: Region; locale: Locale; entries: readonly CatalogEntry[] }
const { region, locale, entries } = Astro.props;
const t = messages[locale];
const c = homepageCopy[locale];
const slots = import.meta.env.DEV ? Math.max(0, 6 - entries.length) : 0;
---
<section id="tools" data-home-section="featured" aria-labelledby="tools-heading" {...stylex.attrs(h.inner, h.section)}>
  <div {...stylex.attrs(h.sectionHead)}>
    <div><h2 id="tools-heading" {...stylex.attrs(h.heading)}>{t.featuredTools}</h2><p {...stylex.attrs(h.intro)}>{c.featuredIntro}</p></div>
    <a href={localizedPath('/tools/', region, locale)} {...stylex.attrs(h.link)}>{t.browseAll}</a>
  </div>
  {entries.length > 0 || slots > 0 ? <>
    <div role="region" tabindex="0" aria-label={c.filmLabel} data-home-film {...stylex.attrs(h.film)}>
      <ul {...stylex.attrs(h.filmList)}>
        {entries.map((tool, index) => <li {...stylex.attrs(h.filmItem)}>
          <a href={tool.href} data-home-tool={tool.id} data-tool-card={tool.id} {...stylex.attrs(h.filmLink)}>
            <HomeMedia media={homepageMedia.tools[tool.id]} locale={locale} decorative />
            <div {...stylex.attrs(h.filmMeta)}><span>{String(index + 1).padStart(2, '0')}</span><span>{registry.find(item => item.id === tool.id)?.status === 'draft' ? c.draft : tool.category}</span></div>
            <h3 {...stylex.attrs(h.filmTitle)}>{tool.title}</h3><p {...stylex.attrs(h.filmDescription)}>{tool.description}</p>
          </a>
        </li>)}
        {Array.from({length: slots}, (_, index) => <li data-home-demo {...stylex.attrs(h.filmItem)}>
          <HomeMedia locale={locale} />
          <div {...stylex.attrs(h.filmMeta)}><span>{String(entries.length + index + 1).padStart(2, '0')}</span><span>{c.demo}</span></div>
          <p {...stylex.attrs(h.filmTitle)}>{c.coverSlot}</p>
        </li>)}
      </ul>
    </div>
    {entries.length + slots > 3 && <p {...stylex.attrs(h.hint)}>{c.filmHint}</p>}
  </> : <div data-catalog-empty {...stylex.attrs(h.empty)}>
    <h3 {...stylex.attrs(h.filmTitle)}>{t.empty}</h3><p {...stylex.attrs(h.intro)}>{t.emptyDetail}</p>
  </div>}
</section>
