---
import styles from './HomeMedia.module.scss';
import { hasHomeMedia, hasHomeMediaSource, type HomeMedia } from '../../site/homepage-showcase';
import type { Locale } from '../../i18n/locale';
interface Props {
  media?: HomeMedia;
  locale: Locale;
  kind?: 'cover' | 'thumbnail' | 'portrait' | 'story' | 'wide';
  decorative?: boolean;
}
const { media, locale, kind = 'cover', decorative = false } = Astro.props;
// Files are verified by static imports; omitted optional media stays absent.
const sources = (['avif', 'webp'] as const).map(format => ({
  type: `image/${format}`,
  srcset: media?.[format]?.filter(hasHomeMediaSource).map(candidate => `${candidate.src} ${candidate.width}w`).join(', '),
})).filter(source => source.srcset);
---
{hasHomeMedia(media) && <div data-home-media={kind} class:list={[styles.media, styles[kind]]}>
  <picture class={styles.picture}>
    {sources.map(source => <source type={source.type} srcset={source.srcset} sizes={media.sizes ?? '100vw'} />)}
    <img src={media.src} alt={decorative ? '' : media.alt[locale]} width={media.width} height={media.height} loading="lazy" decoding="async" style={{objectPosition: media.focus ?? 'center'}} class:list={[styles.image, kind === 'portrait' && styles.portraitImage]} />
  </picture>
</div>}
