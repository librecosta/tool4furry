---
import * as stylex from '@stylexjs/stylex';
import type { Locale } from '../../i18n/locale';
import { localizedPath } from '../../i18n/locale';
import type { Region } from '../../config/region';
import { messages } from '../../i18n/messages';
import { homeStyles as h } from '../../styles/homepage';
interface Props { region: Region; locale: Locale; hasTools: boolean }
const { region, locale, hasTools } = Astro.props;
const t = messages[locale];
---
<section data-home-section="hero" aria-labelledby="hero-heading" {...stylex.attrs(h.hero)}>
  <div data-hero-media data-wavefield="static" {...stylex.attrs(h.heroScene)}>
    <img src="/visuals/wavefield/wavefield.avif" width="1440" height="576" alt="" aria-hidden="true" fetchpriority="high" decoding="async" {...stylex.attrs(h.wavePoster)} />
    <canvas data-wavefield-canvas aria-hidden="true" {...stylex.attrs(h.waveCanvas)}></canvas>
    <div aria-hidden="true" {...stylex.attrs(h.waveVeil)}></div>
  </div>
  <div {...stylex.attrs(h.inner)}>
    <div {...stylex.attrs(h.heroContent)}>
      <h1 id="hero-heading" {...stylex.attrs(h.heroTitle)}>{t.heroLead}{locale === 'en' ? ' ' : ''}<span {...stylex.attrs(h.heroLine)}>{t.heroAccent}</span></h1>
      <p {...stylex.attrs(h.heroIntro)}>{t.intro}</p>
      <a href={hasTools ? '#tools' : localizedPath('/tools/', region, locale)} data-home-cta {...stylex.attrs(h.heroCta)}>{t.explore}</a>
      {!hasTools && <p {...stylex.attrs(h.heroStatus)}>{t.heroStatus}</p>}
    </div>
  </div>
</section>

<script src="../../visuals/wavefield/entry.ts"></script>
