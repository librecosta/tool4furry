---
import styles from './ThreePillars.module.scss';
import { CursorClickIcon, ShieldCheckIcon, LockKeyIcon } from '@phosphor-icons/react/ssr';
import type { Region } from '../../config/region';
import { localizedPath, type Locale } from '../../i18n/locale';
import { homepagePillars } from '../../site/homepage-showcase';
import revealSource from '../../styles/pillars-reveal.js?raw';
interface Props { region: Region; locale: Locale }
const { region, locale } = Astro.props;
const icons = { experience: CursorClickIcon, safety: ShieldCheckIcon, privacy: LockKeyIcon };
---
<section data-home-pillars aria-labelledby="pillars-heading" class={styles.section}>
  <h2 id="pillars-heading" class={styles.capHeading}>
    <span data-pillar-part="cap" aria-hidden="true" class={styles.cap} />
    <span data-pillar-part="cap-title" class={styles.capTitle}>{locale === 'zh' ? '关于 Tool4Furry' : 'About Tool4Furry'}</span>
    <span data-pillar-part="cap" aria-hidden="true" class={styles.cap} />
  </h2>
  <div class={styles.grid}>
    {homepagePillars[locale].map((pillar, index) => { const Icon = icons[pillar.id]; return <article data-pillar={pillar.id} aria-labelledby={`pillar-${pillar.id}`} class:list={[styles.pillar, index === 1 && styles.second, index === 2 && styles.third]}>
      {index > 0 && <span data-pillar-separator aria-hidden="true" class={styles.separator}><span data-pillar-part="line" class={styles.stroke} /></span>}
      <div class={styles.heading}>
        <div aria-hidden="true" class={styles.numberWindow}><span data-pillar-part="number" class:list={[styles.motion, styles.number]}>{String(index + 1).padStart(2, '0')}</span></div>
        <h3 id={`pillar-${pillar.id}`} data-pillar-part="title" class:list={[styles.motion, styles.title]}>{pillar.title}</h3>
      </div>
      <div class={styles.body}>
        {/* Independent decorative slots remain keyed by column for future approved artwork. */}
        <span data-pillar-artwork={pillar.id} data-pillar-part="icon" aria-hidden="true" class:list={[styles.motion, styles.icon]}><Icon size={64} weight="regular" focusable="false" className={styles.iconSvg} /></span>
        <p data-pillar-part="description" class:list={[styles.motion, styles.description]}>{pillar.description}</p>
      </div>
      <div data-pillar-part="links" class:list={[styles.motion, styles.links]}>{pillar.links.map(link => <a href={link.href.startsWith('/') ? localizedPath(link.href, region, locale) : link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined} class={styles.link}><span class={styles.linkText}>{link.label}</span></a>)}</div>
    </article>; })}
  </div>
</section>
<script is:inline id="t4f-home-pillars" set:html={revealSource} />
