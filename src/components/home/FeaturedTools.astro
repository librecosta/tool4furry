---
import styles from './FeaturedTools.module.scss';
import type { Locale } from '../../i18n/locale';
import { localizedPath } from '../../i18n/locale';
import type { Region } from '../../config/region';
import type { CatalogEntry } from '../../site/catalog';
import { messages } from '../../i18n/messages';
import { tools as registry } from '../../tools/registry';
import { homepageCopy, homepageMedia, getFeaturedShowcase, hasHomeMedia } from '../../site/homepage-showcase';
import FeaturedToolIcon from './FeaturedToolIcon.astro';
interface Props { region: Region; locale: Locale; entries: readonly CatalogEntry[] }
const { region, locale, entries } = Astro.props;
const t = messages[locale];
const c = homepageCopy[locale];
const cards = getFeaturedShowcase(entries);
const decor = homepageMedia.featuredDecor;
const presentDecor = hasHomeMedia(decor);
---
<div data-home-section="featured" class:list={[styles.inner, styles.featuredSection]}>
  <div data-featured-layout class:list={[styles.featuredLayout, presentDecor && styles.featuredWithDecor]}>
  {presentDecor && decor && <div data-home-decor aria-hidden="true" class={styles.featuredDecor}>
    <img src={decor.src} width={decor.width} height={decor.height} alt="" loading="lazy" decoding="async" class={styles.featuredDecorImage} />
  </div>}
  <div data-featured-content class={styles.featuredContent}>
  <div class:list={[styles.sectionHead, styles.featuredHead]}>
    <h2 id="tools-heading" class={styles.heading}>{t.featuredTools}</h2>
    <a href={localizedPath('/tools/', region, locale)} class={styles.link}><span class={styles.linkText}>{t.browseAll}</span></a>
  </div>
  {cards.length > 0 ? <ul data-home-featured class={styles.featuredGrid}>
    {cards.map(card => <li class={styles.featuredItem}>
        <a href={card.href} data-home-tool={card.id} data-tool-card={card.id} class:list={[styles.featuredCard, styles.featuredInteractive]}>
          <span class={styles.featuredIconPlate}><FeaturedToolIcon id={card.id} size={48} /></span>
          <div class={styles.featuredText}>
            <h3 class={styles.featuredTitle}>{card.title}{import.meta.env.DEV && registry.find(tool => tool.id === card.id)?.status === 'draft' && <span class={styles.featuredStatus}>{c.draft}</span>}</h3>
            <p class={styles.featuredDescription}>{card.description}</p>
          </div>
        </a>
      </li>)}
  </ul> : <div data-catalog-empty class={styles.empty}>
    <h3 class={styles.featuredTitle}>{t.empty}</h3><p class={styles.intro}>{t.emptyDetail}</p>
  </div>}
  </div>
  </div>
</div>
