---
import * as stylex from '@stylexjs/stylex';
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import type { Locale } from '../../i18n/locale';
import { localizedPath } from '../../i18n/locale';
import type { Region } from '../../config/region';
import type { CatalogEntry } from '../../site/catalog';
import { messages } from '../../i18n/messages';
import { tools as registry } from '../../tools/registry';
import { homepageCopy, homepageMedia, getFeaturedShowcase } from '../../site/homepage-showcase';
import { homeStyles as h } from '../../styles/homepage';
import FeaturedToolIcon from './FeaturedToolIcon.astro';
interface Props { region: Region; locale: Locale; entries: readonly CatalogEntry[] }
const { region, locale, entries } = Astro.props;
const t = messages[locale];
const c = homepageCopy[locale];
const cards = getFeaturedShowcase(entries);
const decor = homepageMedia.featuredDecor;
const presentDecor = decor && /^\/(?!\/)(?!.*\.\.)[^?#]+$/.test(decor.src)
  && Number.isInteger(decor.width) && decor.width > 0 && Number.isInteger(decor.height) && decor.height > 0
  && statSync(resolve('public', decor.src.slice(1)), { throwIfNoEntry: false })?.isFile();
---
<div data-home-section="featured" {...stylex.attrs(h.inner, h.featuredSection)}>
  <div data-featured-layout {...stylex.attrs(h.featuredLayout, presentDecor && h.featuredWithDecor)}>
  {presentDecor && decor && <div data-home-decor aria-hidden="true" {...stylex.attrs(h.featuredDecor)}>
    <img src={decor.src} width={decor.width} height={decor.height} alt="" loading="lazy" decoding="async" {...stylex.attrs(h.featuredDecorImage)} />
  </div>}
  <div data-featured-content {...stylex.attrs(h.featuredContent)}>
  <div {...stylex.attrs(h.sectionHead, h.featuredHead)}>
    <h2 id="tools-heading" {...stylex.attrs(h.heading)}>{t.featuredTools}</h2>
    <a href={localizedPath('/tools/', region, locale)} {...stylex.attrs(h.link)}><span {...stylex.attrs(h.linkText)}>{t.browseAll}</span></a>
  </div>
  {cards.length > 0 ? <ul data-home-featured {...stylex.attrs(h.featuredGrid)}>
    {cards.map(card => <li {...stylex.attrs(h.featuredItem)}>
        <a href={card.href} data-home-tool={card.id} data-tool-card={card.id} {...stylex.attrs(h.featuredCard, h.featuredInteractive)}>
          <span {...stylex.attrs(h.featuredIconPlate)}><FeaturedToolIcon id={card.id} /></span>
          <div {...stylex.attrs(h.featuredText)}>
            <h3 {...stylex.attrs(h.featuredTitle)}>{card.title}{import.meta.env.DEV && registry.find(tool => tool.id === card.id)?.status === 'draft' && <span {...stylex.attrs(h.featuredStatus)}>{c.draft}</span>}</h3>
            <p {...stylex.attrs(h.featuredDescription)}>{card.description}</p>
          </div>
        </a>
      </li>)}
  </ul> : <div data-catalog-empty {...stylex.attrs(h.empty)}>
    <h3 {...stylex.attrs(h.featuredTitle)}>{t.empty}</h3><p {...stylex.attrs(h.intro)}>{t.emptyDetail}</p>
  </div>}
  </div>
  </div>
</div>
