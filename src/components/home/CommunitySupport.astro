---
import styles from './CommunitySupport.module.scss';
import type { Region } from '../../config/region';
import type { Locale } from '../../i18n/locale';
import { getCommunityCards } from '../../site/home-community';
interface Props { region: Region; locale: Locale }
const { region, locale } = Astro.props;
---
<section data-home-community aria-labelledby="community-heading" class={styles.section}>
  <h2 id="community-heading" class={styles.accessibleHeading}>{locale === 'zh' ? '社群与支持' : 'Community & Support'}</h2>
  <div class={styles.grid}>
    {getCommunityCards(region, locale).map(card => <article data-community-card={card.id} aria-labelledby={`community-${card.id}`} class={styles.card}>
      <h3 id={`community-${card.id}`} class={styles.title}>{card.title}</h3>
      {card.qr ? <div class={styles.qqBody}>
        <div class={styles.qqCopy}><p class={styles.description}>{card.description}</p><p class:list={[styles.note, styles.qqHint]}>{card.note}</p></div>
        <img src={card.qr.src} width={card.qr.width} height={card.qr.height} alt={card.qr.alt} loading="lazy" class={styles.qr} />
      </div> : <>
        <p class:list={[styles.description, styles.centeredCopy]}>{card.description}</p>
        <div class={styles.footer}>
          {card.note && <p class={styles.note}>{card.note}</p>}
          <a href={card.href} target="_blank" rel="noopener noreferrer" class={styles.action}>
            <img src={card.logo} width="20" height="20" alt="" aria-hidden="true" loading="lazy" class={styles.logo} />{card.action}
          </a>
        </div>
      </>}
    </article>)}
  </div>
</section>
