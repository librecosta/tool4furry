---
import styles from './FeaturedToolIcon.module.scss';
import { SquaresFourIcon } from '@phosphor-icons/react/ssr';
import { getToolIcon } from '../../site/tool-icons';
interface Props { id: string; size?: number }
const { id, size = 40 } = Astro.props;
const icon = getToolIcon(id);
---
{icon ? <img
  data-tool-icon={id}
  src={icon[size <= 32 ? 32 : 128]}
  srcset={`${icon[32]} 32w, ${icon[128]} 128w`}
  sizes={`${size}px`}
  width={size}
  height={size}
  alt=""
  decoding="async"
  class={styles.pixelToolIcon}
/> : <SquaresFourIcon data-tool-icon-fallback size={size} weight="regular" color="currentColor" aria-hidden="true" focusable="false" className={styles.featuredIcon} />}
