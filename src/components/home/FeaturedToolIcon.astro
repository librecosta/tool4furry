---
import * as stylex from '@stylexjs/stylex';
import { SquaresFourIcon } from '@phosphor-icons/react/ssr';
import { homeStyles as h } from '../../styles/homepage';
import { getToolIcon } from '../../site/tool-icons';
interface Props { id: string; size?: number }
const { id, size = 40 } = Astro.props;
const icon = getToolIcon(id);
---
{icon ? <img
  data-tool-icon={id}
  src={icon[size <= 32 ? 32 : 128]}
  srcset={`${icon[32]} 32w, ${icon[128]} 128w`}
  sizes={`${size}px`}
  width={size}
  height={size}
  alt=""
  decoding="async"
  {...stylex.attrs(h.pixelToolIcon)}
/> : <SquaresFourIcon data-tool-icon-fallback size={size} weight="regular" color="currentColor" aria-hidden="true" focusable="false" className={stylex.attrs(h.featuredIcon).class} />}
