---
import styles from './RoleShowcases.module.scss';
import type { Locale } from '../../i18n/locale';
import { localizedPath } from '../../i18n/locale';
import type { Region } from '../../config/region';
import { homepageCopy, getRoleShowcases, hasHomeMedia } from '../../site/homepage-showcase';
import HomeMedia from './HomeMedia.astro';
import RoleIcon from './RoleIcon.astro';
import FeaturedToolIcon from './FeaturedToolIcon.astro';
interface Props { region: Region; locale: Locale }
const { region, locale } = Astro.props;
const roles = getRoleShowcases(region, locale, import.meta.env.DEV).map(role => ({
  ...role,
  showArtwork: hasHomeMedia(role.media),
}));
const c = homepageCopy[locale];
---
<div data-home-section="roles" class:list={[styles.inner, styles.rolesSection]}>
    <div class={styles.roles}>{roles.map(role => <article data-home-role={role.id} aria-labelledby={`role-${role.id}`} class={styles.role}>
      <div class={styles.roleHead}>
        <div>
          <div class={styles.roleIdentity}><RoleIcon id={role.id} media={role.icon} /><h3 id={`role-${role.id}`} class={styles.roleTitle}>{role.label[locale]}</h3></div>
          <p class={styles.roleDescription}>{role.description[locale]}</p>
        </div>
        <a href={localizedPath('/tools/', region, locale)} aria-label={`${role.label[locale]} — ${c.more}`} class:list={[styles.link, styles.roleMore]}><span class={styles.linkText}>{c.more}</span></a>
      </div>
      <div class:list={[styles.roleBody, role.showArtwork && styles.roleWithArtwork]}>
        {role.showArtwork && <div data-role-artwork class={styles.roleVisual}><HomeMedia media={role.media} kind="portrait" locale={locale} decorative /></div>}
        {role.entries.length > 0 ? <div class={styles.roleToolArea}><ul class={styles.roleTools}>
          {role.entries.map(tool => <li>
            <a href={tool.href} title={tool.title} data-home-role-tool={tool.id} class={styles.roleTool}>
              <FeaturedToolIcon id={tool.id} size={24} />
              <span class={styles.roleToolTitle}>{tool.title}</span>
            </a>
          </li>)}
        </ul></div> : <p class={styles.roleEmpty}>{c.roleEmpty}</p>}
      </div>
    </article>)}</div>
</div>
