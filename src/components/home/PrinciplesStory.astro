---
import * as stylex from '@stylexjs/stylex';
import type { Region } from '../../config/region';
import { localizedPath, type Locale } from '../../i18n/locale';
import { messages } from '../../i18n/messages';
import { homepageCopy, homepageMedia } from '../../site/homepage-showcase';
import { homeStyles as h } from '../../styles/homepage';
import HomeMedia from './HomeMedia.astro';
interface Props { region: Region; locale: Locale }
const { region, locale } = Astro.props;
const t = messages[locale];
const c = homepageCopy[locale];
---
<section data-home-section="principles" aria-labelledby="principles-heading" {...stylex.attrs(h.inner, h.principles)}>
  <div {...stylex.attrs(h.editorial)}>
    <h2 id="principles-heading" {...stylex.attrs(h.heading)}>{c.principlesTitle}</h2>
    <div><p {...stylex.attrs(h.intro)}>{c.principlesIntro}</p><p {...stylex.attrs(h.intro)}>{c.principlesDetail}</p>
      <div {...stylex.attrs(h.editorialLinks)}>
        <a href={localizedPath('/about/', region, locale)} {...stylex.attrs(h.link)}>{t.about}</a>
        <a href="https://github.com/librecosta/tool4furry" {...stylex.attrs(h.link)}>{t.source}</a>
        <a href={localizedPath('/privacy/', region, locale)} {...stylex.attrs(h.link)}>{t.privacy}</a>
      </div>
    </div>
  </div>
  <HomeMedia media={homepageMedia.principles} kind="wide" locale={locale} />
  <p {...stylex.attrs(h.caption)}>{c.principlesNote}</p>
</section>
