---
import * as stylex from '@stylexjs/stylex';
import { GithubLogoIcon } from '@phosphor-icons/react/ssr';
import type { Region } from '../../config/region';
import { getComplianceEntries, showCompliancePreview } from '../../config/compliance';
import { messages } from '../../i18n/messages';
import { siteStyles as s } from '../../styles/site';
import Brand from './Brand.astro';

interface Props { region: Region }
const { region } = Astro.props;
const t = messages[region];
const github = 'https://github.com/librecosta/tool4furry';
const compliance = getComplianceEntries(region);
const compliancePreview = showCompliancePreview(region, import.meta.env.DEV, compliance);
---
<footer data-site-footer {...stylex.attrs(s.fullBleed, s.fluid, s.footerRoot)}>
  <div {...stylex.attrs(s.homeWidth)}>
    <div data-footer-brand {...stylex.attrs(s.footerTop)}>
      <Brand />
      <a data-footer-social href={github} target="_blank" rel="noopener noreferrer" aria-label={t.github} {...stylex.attrs(s.footerSocial)}>
        <GithubLogoIcon size={24} aria-hidden className={stylex.attrs(s.footerSocialIcon).class} />
      </a>
    </div>
    <nav aria-label={t.footerNav} {...stylex.attrs(s.footerLinks)}>
      <div {...stylex.attrs(s.footerGroup)}>
        <p {...stylex.attrs(s.footerGroupHeading)}>{t.footerTools}</p>
        <a {...stylex.attrs(s.footerLink)} href="/#tools">{t.featuredTools}</a>
        <a {...stylex.attrs(s.footerLink)} href="/tools/">{t.browseAll}</a>
      </div>
      <div {...stylex.attrs(s.footerGroup)}>
        <p {...stylex.attrs(s.footerGroupHeading)}>{t.footerProject}</p>
        <a {...stylex.attrs(s.footerLink)} href="/about/">{t.about}</a>
        <a {...stylex.attrs(s.footerLink)} href={github} target="_blank" rel="noopener noreferrer">{t.source}</a>
      </div>
      <div {...stylex.attrs(s.footerGroup)}>
        <p {...stylex.attrs(s.footerGroupHeading)}>{t.footerSupport}</p>
        <a {...stylex.attrs(s.footerLink)} href={`${github}/issues`} target="_blank" rel="noopener noreferrer">{t.feedback}</a>
      </div>
    </nav>
    <div data-footer-compliance-slot {...stylex.attrs(s.footerComplianceSlot)}>
      {compliance.length > 0 && <div data-site-compliance aria-label={region === 'cn' ? '备案与许可信息' : 'Registrations and licenses'} {...stylex.attrs(s.footerCompliance)}>
        {compliance.map(entry => <div data-compliance-kind={entry.kind} {...stylex.attrs(s.complianceCell, entry.kind === 'public-security' && s.compliancePolice, entry.kind === 'additional' && s.complianceAdditional)}>
          {entry.href ? <a href={entry.href} {...stylex.attrs(s.complianceLink)}>
            {entry.iconSrc && <img src={entry.iconSrc} width="20" height="20" alt="" aria-hidden="true" {...stylex.attrs(s.complianceIcon)} />}
            <span>{entry.label}</span>
          </a> : <span {...stylex.attrs(s.complianceText)}>{entry.label}</span>}
        </div>)}
      </div>}
      {compliancePreview && <div data-footer-compliance-preview {...stylex.attrs(s.footerCompliance)}>
        <p {...stylex.attrs(s.complianceCell, s.compliancePreview)}>ICP备案展示位置 · 开发预览</p>
        <p {...stylex.attrs(s.complianceCell, s.compliancePolice, s.compliancePreview)}>公安备案展示位置 · 开发预览</p>
      </div>}
    </div>
    <div data-footer-legal {...stylex.attrs(s.footerBottom)}>
      <div {...stylex.attrs(s.footerLegal)}>
        <nav aria-label={t.footerLegal} {...stylex.attrs(s.footerLegalLinks)}>
          <a {...stylex.attrs(s.footerLink, s.footerLegalLink)} href="/privacy/">{t.privacy}</a>
          <a {...stylex.attrs(s.footerLink, s.footerLegalLink)} href="/terms/">{t.terms}</a>
          <a {...stylex.attrs(s.footerLink, s.footerLegalLink)} href={`${github}/blob/master/LICENSE`}>BSD-3-Clause License</a>
        </nav>
      </div>
      <span {...stylex.attrs(s.footerCopyright)}>© {new Date().getFullYear()} Tool4Furry ·&nbsp;<a data-footer-attribution href="https://librecosta.com" target="_blank" rel="noopener noreferrer" {...stylex.attrs(s.complianceLink)}>LibreCosta</a></span>
    </div>

  </div>
</footer>
