---
import { localizedPath, type Locale } from '../../i18n/locale';
import * as stylex from '@stylexjs/stylex';
import { region } from '../../config/site';
import { siteStyles as s } from '../../styles/site';
import { navigationStyles as n } from '../../styles/navigation';
interface Props { navigation?: boolean; locale: Locale }
const { navigation = false, locale } = Astro.props;
---
<a href={localizedPath('/', region, locale)} aria-label="Tool4Furry" {...stylex.attrs(s.brand, navigation && n.brand)}>
  <img src="/brand/tool4furry-mark.svg" alt="" width="32" height="32" {...stylex.attrs(s.mark)} />
  <span {...stylex.attrs(navigation && n.brandFull)}>Tool4Furry</span>
  {navigation && <span aria-hidden="true" {...stylex.attrs(n.brandShort)}>T4F</span>}
</a>
