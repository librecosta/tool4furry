---
import styles from './Brand.module.scss';
import { localizedPath, type Locale } from '../../i18n/locale';
import { region } from '../../config/site';
interface Props { navigation?: boolean; locale: Locale }
const { navigation = false, locale } = Astro.props;
---
<a href={localizedPath('/', region, locale)} aria-label="Tool4Furry" class:list={[styles.brand, navigation && styles.navigationBrand]}>
  <span data-brand-symbol aria-hidden="true" class:list={[styles.symbol, styles.mark]}></span>
  <span data-brand-wordmark class:list={[navigation && styles.brandFull]}>Tool4Furry</span>
  {navigation && <span aria-hidden="true" class={styles.brandShort}>T4F</span>}
</a>
