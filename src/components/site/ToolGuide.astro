---
import styles from './ToolGuide.module.scss';
import type { Locale } from '../../i18n/locale';
import type { ToolPageContent } from '../../site/tool-content';
import type { CatalogEntry } from '../../site/catalog';
import ToolCards from './ToolCards.astro';
import { messages } from '../../i18n/messages';
interface Props { content: ToolPageContent; related: readonly CatalogEntry[]; locale: Locale }
const { content, related, locale } = Astro.props;
const t = messages[locale];
const hasSteps = !!content.steps?.length;
const hasLimitations = !!content.limitations?.length;
// Only inline emphasis is supported; all text remains escaped Astro content.
const emphasis = (text: string) => text.split(/(\*\*[^*]+\*\*)/g);
---
<div data-tool-guide class:list={[styles.fluid, styles.toolGuide]}>
  {(hasSteps || hasLimitations) && <div data-tool-instructions class:list={[styles.toolInstructions, hasSteps && hasLimitations && styles.toolInstructionColumns]}>
    {hasSteps && <section aria-labelledby="tool-steps"><h2 id="tool-steps" class={styles.sectionHeading}>{content.headings?.steps ?? t.toolSteps}</h2><ol>{content.steps!.map(step => <li>{emphasis(step).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ol></section>}
    {hasLimitations && <section aria-labelledby="tool-limitations"><h2 id="tool-limitations" class={styles.sectionHeading}>{content.headings?.limitations ?? t.toolLimitations}</h2><ul>{content.limitations!.map(item => <li>{emphasis(item).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ul></section>}
  </div>}
  {!!content.features?.length && <details class={styles.faqItem}><summary class={styles.faqQuestion}>{locale === 'zh' ? '功能概览' : 'Features'}</summary><ul>{content.features.map(feature => <li>{emphasis(feature).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ul></details>}
  {content.faq && content.faq.length > 0 && <section aria-labelledby="tool-faq"><h2 id="tool-faq" class={styles.sectionHeading}>{content.headings?.faq ?? t.toolFaq}</h2>{content.faq.map(item => <details class={styles.faqItem}><summary class={styles.faqQuestion}><span>{item.question}</span><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={styles.faqChevron}><path d="m6 9 6 6 6-6" /></svg></summary><p class={styles.faqAnswer}>{item.answer}</p></details>)}</section>}
  {related.length > 0 && <section data-related-tools aria-labelledby="related-tools"><h2 id="related-tools" class={styles.sectionHeading}>{t.relatedTools}</h2><ToolCards entries={related} locale={locale} layout="related" /></section>}
</div>
