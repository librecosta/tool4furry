---
import { localizedPath, type Locale } from '../../i18n/locale';
import * as stylex from '@stylexjs/stylex';
import { siteStyles as s } from '../../styles/site';
import type { ToolPageContent } from '../../site/tool-content';
import type { ToolDefinition } from '../../tools/types';
import type { Region } from '../../config/region';
import { messages } from '../../i18n/messages';
interface Props { content: ToolPageContent; related: readonly ToolDefinition[]; region: Region; locale: Locale }
const { content, related, region, locale } = Astro.props;
const t = messages[locale];
const hasSteps = !!content.steps?.length;
const hasLimitations = !!content.limitations?.length;
// Only inline emphasis is supported; all text remains escaped Astro content.
const emphasis = (text: string) => text.split(/(\*\*[^*]+\*\*)/g);
---
<div data-tool-guide {...stylex.attrs(s.fluid, s.toolGuide)}>
  {(hasSteps || hasLimitations) && <div data-tool-instructions {...stylex.attrs(s.toolInstructions, hasSteps && hasLimitations && s.toolInstructionColumns)}>
    {hasSteps && <section aria-labelledby="tool-steps"><h2 id="tool-steps" {...stylex.attrs(s.sectionHeading)}>{content.headings?.steps ?? t.toolSteps}</h2><ol>{content.steps!.map(step => <li>{emphasis(step).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ol></section>}
    {hasLimitations && <section aria-labelledby="tool-limitations"><h2 id="tool-limitations" {...stylex.attrs(s.sectionHeading)}>{content.headings?.limitations ?? t.toolLimitations}</h2><ul>{content.limitations!.map(item => <li>{emphasis(item).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ul></section>}
  </div>}
  {!!content.features?.length && <details {...stylex.attrs(s.faqItem)}><summary {...stylex.attrs(s.faqQuestion)}>{locale === 'zh' ? '功能概览' : 'Features'}</summary><ul>{content.features.map(feature => <li>{emphasis(feature).map((part, index) => index % 2 ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ul></details>}
  {content.faq && content.faq.length > 0 && <section aria-labelledby="tool-faq"><h2 id="tool-faq" {...stylex.attrs(s.sectionHeading)}>{content.headings?.faq ?? t.toolFaq}</h2>{content.faq.map(item => <details {...stylex.attrs(s.faqItem)}><summary {...stylex.attrs(s.faqQuestion)}><span>{item.question}</span><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" {...stylex.attrs(s.faqChevron)}><path d="m6 9 6 6 6-6" /></svg></summary><p {...stylex.attrs(s.faqAnswer)}>{item.answer}</p></details>)}</section>}
  {related.length > 0 && <section data-related-tools aria-labelledby="related-tools"><h2 id="related-tools" {...stylex.attrs(s.sectionHeading)}>{t.relatedTools}</h2><ul>{related.map(tool => <li><a href={localizedPath(`/tools/${tool.slug}/`, region, locale)} {...stylex.attrs(s.link)}>{tool.copy[locale].title}</a></li>)}</ul></section>}
</div>
