---
import * as stylex from '@stylexjs/stylex';
import { ToolboxIcon, CaretDownIcon } from '@phosphor-icons/react/ssr';
import { region } from '../../config/site';
import { messages } from '../../i18n/messages';
import { getHomepageEntries } from '../../site/catalog';
import { navigationStyles as n } from '../../styles/navigation';
const t = messages[region];
const entries = getHomepageEntries(region, undefined, undefined, import.meta.env.DEV);
---
<details data-tool-disclosure {...stylex.attrs(n.disclosure)}>
  <summary aria-label={t.featuredTools} {...stylex.attrs(n.control, n.trigger)}>
    <span {...stylex.attrs(n.mobileToolbox)}><ToolboxIcon size={20} aria-hidden /></span>
    <span {...stylex.attrs(n.toolboxLabel)}><span {...stylex.attrs(n.labelFull)}>{t.featuredTools}</span><span {...stylex.attrs(n.labelShort)}>{t.featuredToolsShort}</span></span>
    <span {...stylex.attrs(n.chevron)}><CaretDownIcon size={16} aria-hidden /></span>
  </summary>
  <div {...stylex.attrs(n.positioner)}>
    <div data-tool-panel {...stylex.attrs(n.panel)}>
      <div {...stylex.attrs(n.panelHeader)}>
        <span>{t.featuredTools}</span><a href="/tools/" {...stylex.attrs(n.browse)}>{t.browseAll}</a>
      </div>
      <div {...stylex.attrs(n.tools)}>
        {entries.length === 0 && <p {...stylex.attrs(n.empty)}>{t.empty}</p>}
        {entries.map(tool => <a href={tool.href} {...stylex.attrs(n.tool)}>
          <span {...stylex.attrs(n.toolTitle)}>{tool.title}</span>
          <span {...stylex.attrs(n.description)}>{tool.description}</span>
        </a>)}
      </div>
    </div>
  </div>
</details>
