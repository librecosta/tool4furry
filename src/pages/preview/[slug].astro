---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageLanguageLink } from '../../config/navigation';
import ToolRuntime from '../../tools/ToolRuntime';
import { region } from '../../config/site';
import { getToolPreviewPaths } from '../../tools/preview-paths';
import { toolPageContents } from '../../site/tool-content';
import ToolIntro from '../../components/site/ToolIntro.astro';
import ToolGuide from '../../components/site/ToolGuide.astro';
import * as stylex from '@stylexjs/stylex';
import { siteStyles as s } from '../../styles/site';
export function getStaticPaths() { return getToolPreviewPaths(import.meta.env.DEV,region); }
const { tool } = Astro.props;
const content = toolPageContents[tool.id]?.[region];
if (!content) throw new Error('Missing draft preview content');
---
<SiteLayout title={tool.copy[region].title} fullTitle={content.title} description={content.description} workspace noindex>
  <main id="main-content" data-tool-preview={tool.id}>
    <ToolRuntime navigation={pageLanguageLink(Astro.url.pathname)} toolId={tool.id} region={region} preview client:load>
      <div slot="intro"><ToolIntro content={content}/><p data-dev-preview {...stylex.attrs(s.fluid, s.previewNote)}>{region==='cn'?'DEV · 预览':'DEV · Preview'}</p></div>
    </ToolRuntime>
    <ToolGuide content={content} related={[]} region={region}/>
  </main>
</SiteLayout>
