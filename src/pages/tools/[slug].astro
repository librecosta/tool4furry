---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageLanguageLink } from '../../config/navigation';
import ToolRuntime from '../../tools/ToolRuntime';
import { getPublishedTools } from '../../tools/registry';
import { region } from '../../config/site';
import { tools } from '../../tools/registry';
import { toolLoaders } from '../../tools/loaders';
import { assertValidRegistry } from '../../tools/validate-registry';
import { assertPublishedContent, getToolPageContent, getRelatedTools } from '../../site/tool-content';
import ToolIntro from '../../components/site/ToolIntro.astro';
import ToolGuide from '../../components/site/ToolGuide.astro';
export function getStaticPaths() {
  assertValidRegistry(tools, toolLoaders);
  assertPublishedContent();
  return getPublishedTools(region).map(tool => ({ params: { slug: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
const content = getToolPageContent(tool, region);
const related = getRelatedTools(tool, region);
---
<SiteLayout title={tool.copy[region].title} fullTitle={content.title} description={content.description} workspace>
  <main id="main-content" data-tool-id={tool.id} data-tool-region={region}>
    <ToolRuntime navigation={pageLanguageLink(Astro.url.pathname)} toolId={tool.id} region={region} client:load><ToolIntro slot="intro" content={content} /></ToolRuntime>
    <ToolGuide content={content} related={related} region={region} />
  </main>
</SiteLayout>
