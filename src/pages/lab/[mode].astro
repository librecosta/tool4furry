---
import { defaultLocale } from '../../i18n/locale';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageLanguageLink } from '../../config/navigation';
import LabRuntime from '../../lab/LabRuntime';
import { getLabPaths, type LabMode } from '../../lab/routes';
import { region } from '../../config/site';
import { messages } from '../../lab/messages';
export function getStaticPaths() { return getLabPaths(import.meta.env.DEV); }
interface Props { mode: LabMode }
const { mode } = Astro.props;
const locale = defaultLocale(region);
const t = messages[locale];
---
<SiteLayout locale={locale} title={`${t.lab} / ${t[mode]}`} workspace noindex documentScroll={false}>
  <main id="main-content"><LabRuntime navigation={pageLanguageLink(Astro.url.pathname)} mode={mode} region={region} locale={locale} client:load /></main>
</SiteLayout>
