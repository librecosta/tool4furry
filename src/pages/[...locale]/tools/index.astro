---
import { localePaths } from '../../../i18n/locale';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ToolsCatalog from '../../../components/site/ToolsCatalog.astro';
import { region } from '../../../config/site';
import { messages } from '../../../i18n/messages';
export function getStaticPaths() { return localePaths(region); }
const { locale } = Astro.props;
const t = messages[locale];
---
<SiteLayout locale={locale} title={t.tools} fullTitle={t.catalogTitle} description={t.catalogDescription} catalogWorkbench>
  <ToolsCatalog region={region} locale={locale} />
</SiteLayout>
