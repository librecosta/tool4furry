---
import { localePaths } from '../../i18n/locale';
import * as stylex from '@stylexjs/stylex';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { homeStyles as h } from '../../styles/homepage';
import { region } from '../../config/site';
import { messages } from '../../i18n/messages';
import { getHomepageEntries } from '../../site/catalog';
import HomeHero from '../../components/home/HomeHero.astro';
import FeaturedTools from '../../components/home/FeaturedTools.astro';
import RoleShowcases from '../../components/home/RoleShowcases.astro';
import WorkflowStory from '../../components/home/WorkflowStory.astro';
import PrinciplesStory from '../../components/home/PrinciplesStory.astro';
export function getStaticPaths() { return localePaths(region); }
const { locale } = Astro.props;
const t = messages[locale];
const tools = getHomepageEntries(region, undefined, undefined, import.meta.env.DEV, locale);
---
<SiteLayout locale={locale} title={t.home} fullTitle={t.homeTitle} description={t.homeDescription}>
  <main id="main-content" {...stylex.attrs(h.main)}>
    <HomeHero region={region} locale={locale} hasTools={tools.length > 0} />
    <div {...stylex.attrs(h.contentBackground)}>
      <div data-home-dots aria-hidden="true" {...stylex.attrs(h.dotsFade)}>
        <span data-home-dot-side="left" {...stylex.attrs(h.dotsSide, h.dotsLeft)}></span>
        <span data-home-dot-side="right" {...stylex.attrs(h.dotsSide, h.dotsRight)}></span>
      </div>
      <FeaturedTools region={region} locale={locale} entries={tools} />
      <RoleShowcases region={region} locale={locale} />
      <WorkflowStory locale={locale} converter={tools.find(tool => tool.id === 'image-converter')} />
      <PrinciplesStory region={region} locale={locale} />
    </div>
  </main>
</SiteLayout>
