---
import * as stylex from '@stylexjs/stylex';
import { locales, type Locale } from '../i18n/locale';
import { languageLink } from '../site/language';
import { region, regionConfig } from '../config/site';
import { messages } from '../i18n/messages';
import { siteStyles as s } from '../styles/site';
import { tokens } from '../styles/tokens.stylex';
import { resolvePageTheme, resolveTheme } from '../styles/theme';
import appearanceSource from '../styles/appearance-controller.js?raw';
import navigationSource from '../styles/navigation-disclosure.js?raw';
import scrollMetrics from '../ui/scroll-metrics.js?raw';
import scrollSource from '../styles/document-scroll.js?raw';
import { devOrigins, regions } from '../config/region';
import DocumentScrollDock from '../components/site/DocumentScrollDock.astro';
import NavigationControls from '../components/site/NavigationControls.astro';
import ToolboxDisclosure from '../components/site/ToolboxDisclosure.astro';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/global.css';
import Brand from '../components/site/Brand.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { catalogStyles as c } from '../styles/catalog';
interface Props { locale: Locale; title: string; fullTitle?: string; description?: string; workspace?: boolean; noindex?: boolean; documentScroll?: boolean; catalogWorkbench?: boolean }
const { locale, title, fullTitle, description, workspace = false, noindex = false, documentScroll = true, catalogWorkbench = false } = Astro.props;
const scrollEnabled = documentScroll && !catalogWorkbench;
const t = messages[locale];
const canonical = new URL(Astro.url.pathname, regionConfig.site);
const resolvedTitle = fullTitle ?? `${title} · Tool4Furry`;
const resolvedDescription = description ?? t.intro;
// Static data on the default-locale root only; never an executable enhancement.
const website = !noindex && Astro.url.pathname === '/' && locale === regionConfig.defaultLocale
  ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Tool4Furry', url: new URL('/', regionConfig.site).href }).replace(/</g, '\\u003c')
  : undefined;
const socialImage = new URL('/brand/tool4furry-og.png', regionConfig.site).href;
const socialImageAlt = locale === 'zh'
  ? 'Tool4Furry 双兽首图形标与字标，深灰色背景'
  : 'Tool4Furry dual-animal symbol and wordmark on a dark graphite background';
const theme = resolvePageTheme(import.meta.env.DEV, import.meta.env.T4F_DEV_APPEARANCE);
const darkClass = stylex.attrs(resolveTheme({colorTheme:'neutral',appearance:'dark'}).style).class;
const lightClass = stylex.attrs(resolveTheme({colorTheme:'neutral',appearance:'light'}).style).class;
const regionOrigins = JSON.stringify(import.meta.env.DEV ? Object.values(devOrigins) : Object.values(regions).map(value => value.site));
// One exact audited inline script; the React and Astro docks share the pure math.
const documentScrollSource = `(() => {\n${scrollMetrics.replace('export function ', 'function ')}\n${scrollSource}\n})();`;
---
<!doctype html>
<html lang={locales[locale].lang} data-color-theme={theme.colorTheme} data-appearance={theme.appearance} data-catalog-workbench={catalogWorkbench || undefined} {...stylex.attrs(theme.style, s.themeRoot, catalogWorkbench && c.viewport)} style={`--t4f-focus: ${tokens.focus};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline id="t4f-appearance" data-dark={darkClass} data-light={lightClass} data-default={theme.appearance} data-region-origins={regionOrigins} set:html={appearanceSource} />
    <meta name="description" content={resolvedDescription} />
    <title>{resolvedTitle}</title>
    {website && <script is:inline type="application/ld+json" id="t4f-website" set:html={website} />}
    <link rel="icon" type="image/vnd.microsoft.icon" sizes="16x16 24x24 32x32 48x48 64x64 128x128 256x256" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/brand/tool4furry-favicon.png" />
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang={locales[locale].lang} href={canonical} />
      <link rel="alternate" hreflang={languageLink(Astro.url.pathname, region).hreflang} href={new URL(languageLink(Astro.url.pathname, region).href, regionConfig.site)} />
      <meta property="og:title" content={resolvedTitle} />
      <meta property="og:description" content={resolvedDescription} />
      <meta property="og:url" content={canonical} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Tool4Furry" />
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:alt" content={socialImageAlt} />
      <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
      <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {import.meta.env.DEV && <>
      <link rel="stylesheet" href="/virtual:stylex.css" />
      <script is:inline type="module" src="/src/styles/stylex-dev-css.ts"></script>
    </>}
  </head>
  <body {...stylex.attrs(s.body, catalogWorkbench && c.viewport)}>
    <div {...stylex.attrs(s.frame, catalogWorkbench && c.frame)}>
      <div data-site-background aria-hidden="true" {...stylex.attrs(s.pageBackground)}></div>
      <div data-page-dots aria-hidden="true" {...stylex.attrs(s.pageDots, workspace && !documentScroll && s.workspaceDotsHidden)}>
        <span data-page-dot-side="left" {...stylex.attrs(s.pageDotSide, s.pageDotsLeft)}></span>
        <span data-page-dot-side="right" {...stylex.attrs(s.pageDotSide, s.pageDotsRight)}></span>
      </div>
      <a {...stylex.attrs(s.skip)} href="#main-content">{t.skip}</a>
      {!workspace && <header data-site-header {...stylex.attrs(s.fullBleed, s.productHeader, catalogWorkbench && c.header)}>
        <nav {...stylex.attrs(s.fluid, s.nav)} aria-label={t.headerNav}>
          <div {...stylex.attrs(s.navLinks)}>
            <Brand navigation locale={locale} />
            <ToolboxDisclosure locale={locale} />
          </div>
          <NavigationControls locale={locale} />
        </nav>
      </header>}
      <slot />
      {!catalogWorkbench && <SiteFooter region={region} locale={locale} />}
    </div>
    <script is:inline id="t4f-navigation" set:html={navigationSource} />
    {scrollEnabled && <>
      <DocumentScrollDock region={region} locale={locale} />
      <script is:inline id="t4f-document-scroll" set:html={documentScrollSource} />
    </>}
  </body>
</html>
